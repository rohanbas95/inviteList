rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite app config — any signed-in user can read (to check membership);
    // only the owner can create; members can update (for joining)
    match /inviteApp/config {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Guest entries — any signed-in user can read/write
    // (app-level logic checks membership before showing UI)
    match /invites/{inviteId} {
      allow read, write: if request.auth != null;
    }
  }
}
